{
  "name": "lostark-party-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "config:check:pc": "node scripts/production-config.mjs --role pc --env-file .env",
    "config:check:server": "node scripts/production-config.mjs --role server --env-file .env",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "worker:notifications": "tsx src/worker/notification-worker.ts",
    "worker:characters": "tsx src/worker/character-sync-worker.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "date-fns": "4.4.0",
    "discord.js": "14.28.1",
    "nanoid": "5.1.16",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "25.9.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/ui": "4.1.12",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "jsdom": "29.1.1",
    "playwright": "1.65.0",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "8.5.32",
    "sharp": "0.35.5",
    "deepmerge-ts": "8.0.0"
  }
}
