{
  "schemaVersion": "2.2",
  "description": "LostARK fixed root entry; main push SHA and run only; no arbitrary command parameter",
  "parameters": {
    "Sha": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[0-9a-f]{40}$"
    },
    "RunId": {
      "type": "String",
      "interpolationType": "ENV_VAR",
      "allowedPattern": "^[1-9][0-9]{0,19}$"
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "deployRootEntry",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "1800",
        "runCommand": [
          "set -eu",
          ": \"${SSM_Sha:?missing_sha}\"",
          ": \"${SSM_RunId:?missing_run_id}\"",
          "exec /usr/local/libexec/lostark-event-entry \"$SSM_Sha\" \"$SSM_RunId\""
        ]
      }
    }
  ]
}
